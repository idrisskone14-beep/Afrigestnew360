// ════════════════════════════════════════════════════════════════
// PHASE 3B — Produits & stock
// ════════════════════════════════════════════════════════════════

enum ProductType {
  GOODS
  SERVICE
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, name])
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  sku         String
  name        String
  description String?
  type        ProductType @default(GOODS)
  categoryId  String?     @db.Uuid
  unit        String      @default("unité")
  barcode     String?
  salePrice   Decimal     @default(0) @db.Decimal(18, 2)
  // Coût moyen pondéré, mis à jour à chaque entrée valorisée
  costPrice   Decimal     @default(0) @db.Decimal(18, 4)
  taxId       String?     @db.Uuid
  trackStock  Boolean     @default(true)
  minStock    Decimal     @default(0) @db.Decimal(18, 3)
  isActive    Boolean     @default(true)
  createdById String?     @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  levels    StockLevel[]
  movements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@index([companyId, barcode])
}

model Warehouse {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  name      String
  code      String
  address   String?
  branchId  String?   @db.Uuid
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  levels    StockLevel[]
  movements StockMovement[]

  @@unique([companyId, code])
}

model StockLevel {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  productId   String   @db.Uuid
  warehouseId String   @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(18, 3)
  reserved    Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([companyId, warehouseId])
}

// Chaque mouvement est tracé : quantité SIGNÉE (+ entrée, − sortie), origine, motif, auteur.
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid
  productId       String            @db.Uuid
  warehouseId     String            @db.Uuid
  type            StockMovementType
  quantity        Decimal           @db.Decimal(18, 3)
  unitCost        Decimal?          @db.Decimal(18, 4)
  reference       String?
  sourceType      String?
  sourceId        String?           @db.Uuid
  reason          String?
  transferGroupId String?           @db.Uuid
  date            DateTime          @default(now())
  createdById     String?           @db.Uuid
  createdAt       DateTime          @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([companyId, productId, date])
  @@index([companyId, warehouseId, date])
  @@index([companyId, sourceType, sourceId])
}
