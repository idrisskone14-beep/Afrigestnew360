# ── Base de données ───────────────────────────────────────────────
# Connexion applicative (rôle afrigest_app : SANS BYPASSRLS → RLS appliquée)
DATABASE_URL="postgresql://afrigest_app:CHANGE_ME_APP_PASSWORD@localhost:54329/afrigest"
# Connexion propriétaire (migrations, seed, provisioning du rôle applicatif uniquement)
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/afrigest"
# Mot de passe appliqué au rôle afrigest_app par `npm run db:app-role`
APP_DB_PASSWORD="CHANGE_ME_APP_PASSWORD"

# ── Auth.js ───────────────────────────────────────────────────────
# Générer : openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# URL publique de l'application
APP_URL="http://localhost:3000"
# Chiffrement des secrets 2FA (AES-256-GCM) : 64 caractères hexadécimaux. Générer : openssl rand -hex 32
ENCRYPTION_KEY=""

# ── Plateforme ────────────────────────────────────────────────────
# E-mail du propriétaire de la plateforme (accès /super-admin) — créé par le seed
PLATFORM_OWNER_EMAIL="owner@afrigest360.local"
# Mot de passe initial du propriétaire (seed uniquement ; à changer immédiatement)
PLATFORM_OWNER_PASSWORD=""
# Exiger la vérification e-mail avant connexion (true en production)
REQUIRE_EMAIL_VERIFICATION="false"

# Dossier des fichiers téléversés (logos…). Défaut : ./uploads
# UPLOAD_DIR=""

# Stockage S3-compatible (Amazon S3, Cloudflare R2, Scaleway, Backblaze B2, MinIO…) : OBLIGATOIRE sur Vercel (disque éphémère).
# Bucket PRIVÉ : l'application contrôle l'accès à chaque fichier. Si S3_BUCKET est vide, les fichiers vont dans UPLOAD_DIR.
# S3_BUCKET=""
# S3_REGION="auto"                # « auto » pour Cloudflare R2 ; ex. eu-west-3 pour Amazon S3
# S3_ENDPOINT=""                  # vide pour Amazon S3 ; ex. https://<compte>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"     # "true" pour MinIO et certains fournisseurs
# S3_KEY_PREFIX=""                # dossier racine dans le bucket (optionnel)

# ── Pages légales (mentions légales, conditions d'utilisation, confidentialité) ──
# Informations de l'éditeur affichées sur le site. Une valeur absente s'affiche « [à compléter] ».
# LEGAL_COMPANY=""        # dénomination sociale
# LEGAL_FORM=""           # ex. SARL au capital de 1 000 000 FCFA
# LEGAL_ADDRESS=""        # siège social
# LEGAL_REGISTRATION=""   # RCCM, identifiant fiscal
# LEGAL_PUBLISHER=""      # directeur de la publication
# LEGAL_EMAIL=""          # contact (droits d'accès aux données, questions légales)
# LEGAL_PHONE=""          # facultatif
# LEGAL_HOST=""           # hébergeurs, ex. Vercel Inc. (application), Neon (base de données), Cloudflare (fichiers)
# LEGAL_COUNTRY=""        # pays dont le droit s'applique
# LEGAL_AUTHORITY=""      # autorité de protection des données de ce pays

# ── E-mail ────────────────────────────────────────────────────────
# Sans clé : les e-mails sont affichés dans la console serveur (développement).
RESEND_API_KEY=""
MAIL_FROM="KAKO Gestion <no-reply@afrigest360.com>"

# ── Tâches planifiées ─────────────────────────────────────────────
# Secret (16 caractères minimum) autorisant l'appel de /api/cron/alerts (Authorization: Bearer …).
# Sans valeur, la route est désactivée. Générer : openssl rand -hex 24
CRON_SECRET=""

# ── Suivi d'erreurs (Sentry) ──
# DSN du projet Sentry (Settings → Client Keys). Vide : aucune erreur n'est envoyée. Aucune donnée personnelle n'est transmise.
# Le DSN est figé à la construction : redéployer après l'avoir modifié.
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT=""   # optionnel ; défaut : production / preview (Vercel)

# ── Performances ──────────────────────────────────────────────────
# Connexions à la base par instance serverless (défaut 10). Voir docs/EXPLOITATION.md §2 pour le dimensionnement.
# DATABASE_POOL_MAX="10"

# Paiement en ligne des abonnements (PayDunya) — facultatif ; voir docs/DEPLOIEMENT.md §14
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test (bac à sable, défaut) ou live (production)
PAYDUNYA_MODE=test
