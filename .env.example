# ── Base de données ───────────────────────────────────────────────
# Connexion applicative (rôle afrigest_app : SANS BYPASSRLS → RLS appliquée)
DATABASE_URL="postgresql://afrigest_app:CHANGE_ME_APP_PASSWORD@localhost:54329/afrigest"
# Connexion propriétaire (migrations, seed, provisioning du rôle applicatif uniquement)
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/afrigest"
# Mot de passe appliqué au rôle afrigest_app par `npm run db:app-role`
APP_DB_PASSWORD="CHANGE_ME_APP_PASSWORD"

# ── Auth.js ───────────────────────────────────────────────────────
# Générer : openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# URL publique de l'application
APP_URL="http://localhost:3000"
# Chiffrement des secrets 2FA (AES-256-GCM) : 64 caractères hexadécimaux. Générer : openssl rand -hex 32
ENCRYPTION_KEY=""

# ── Plateforme ────────────────────────────────────────────────────
# E-mail du propriétaire de la plateforme (accès /super-admin) — créé par le seed
PLATFORM_OWNER_EMAIL="owner@afrigest360.local"
# Mot de passe initial du propriétaire (seed uniquement ; à changer immédiatement)
PLATFORM_OWNER_PASSWORD=""
# Exiger la vérification e-mail avant connexion (true en production)
REQUIRE_EMAIL_VERIFICATION="false"

# Dossier des fichiers téléversés (logos…). Défaut : ./uploads
# UPLOAD_DIR=""

# ── E-mail ────────────────────────────────────────────────────────
# Sans clé : les e-mails sont affichés dans la console serveur (développement).
RESEND_API_KEY=""
MAIL_FROM="AfriGest 360 <no-reply@afrigest360.com>"

# ── Tâches planifiées ─────────────────────────────────────────────
# Secret (16 caractères minimum) autorisant l'appel de /api/cron/alerts (Authorization: Bearer …).
# Sans valeur, la route est désactivée. Générer : openssl rand -hex 24
CRON_SECRET=""

# ── Performances ──────────────────────────────────────────────────
# Connexions à la base par instance serverless (défaut 10). Voir docs/EXPLOITATION.md §2 pour le dimensionnement.
# DATABASE_POOL_MAX="10"
